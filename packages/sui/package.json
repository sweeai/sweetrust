{
  "name": "sweetrust-sui",
  "version": "0.1.0",
  "description": "SweeTrust's Sui adapter: delegated spending on Sui's native allowance (0x2::allowance). Every receipt says which limit the chain held, which the library held, and in plain English why a spend was refused.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweeai/sweetrust.git",
    "directory": "packages/sui"
  },
  "homepage": "https://github.com/sweeai/sweetrust/tree/main/packages/sui#readme",
  "bugs": "https://github.com/sweeai/sweetrust/issues",
  "keywords": [
    "ai-agents",
    "sui",
    "allowance",
    "delegated-spending",
    "spending-limits",
    "rate-limit",
    "receipts",
    "sweetrust"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck",
    "test": "vitest run",
    "test:testnet": "vitest run test/conformance",
    "typecheck": "tsc --noEmit && node --experimental-strip-types scripts/readme-typecheck.ts",
    "typecheck:readme": "node --experimental-strip-types scripts/readme-typecheck.ts",
    "build": "tsdown"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.35.0",
    "sweetrust": "^0.7.0"
  },
  "devDependencies": {
    "@mysten/sui": "2.35.0",
    "@types/node": "^22.0.0",
    "sweetrust": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
